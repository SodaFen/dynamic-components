{
  "pages": [
    {
      "title": "Вход в систему",
      "direction": "vertical",
      "styles": {
        "display": "flex",
        "align-items": "center",
        "padding": "2rem",
        "border-radius": "8px",
        "background": "#f8f9fa",
        "font-size": "24px",
        "color": "#333"
      },
      "elements": [
        {
          "type": "input",
          "id": "userEmail",
          "inputType": "email",
          "placeholder": "Введите почту",
          "styles": {
            "font-size": "13px",
            "padding": "8px",
            "border": "1px solid #ccc",
            "border-radius": "4px"
          }
        },
        {
          "type": "input",
          "id": "userPassword",
          "inputType": "password",
          "placeholder": "Введите пароль",
          "styles": {
            "font-size": "13px",
            "padding": "8px",
            "border": "1px solid #ccc",
            "border-radius": "4px",
            "margin-top": "10px"
          }
        },
        {
          "type": "button",
          "id": "enter",
          "text": "Войти",
          "event": "submit",
          "styles": {
            "cursor": "pointer",
            "background-color": "#2196F3",
            "color": "white",
            "padding": "10px 15px",
            "border": "none",
            "border-radius": "10px",
            "margin-top": "10px"
          }
        }
      ]
    },
    {
      "direction": "horizontal",
      "styles": {
        "display": "flex",
        "align-items": "center",
        "padding": "2rem",
        "border-radius": "8px",
        "background": "#f8f9fa",
        "font-size": "24px",
        "color": "#333"
      },
      "elements": [
        {
          "type": "text",
          "id": "enterData",
          "content": "Введите указанные данные"
        },
        {
          "type": "input",
          "id": "lastName",
          "placeholder": "Фамилия",
          "styles": {
            "font-size": "13px",
            "padding": "8px"
          }
        },
        {
          "type": "input",
          "id": "firstName",
          "placeholder": "Имя",
          "styles": {
            "font-size": "13px",
            "padding": "8px"
          }
        },
        {
          "type": "input",
          "id": "birthDate",
          "inputType": "date",
          "styles": {
            "font-size": "13px",
            "padding": "8px"
          }
        }
      ]
    }
  ]
}
